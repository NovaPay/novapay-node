<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NovaPay demo</title>
  <style>
    :root { color-scheme: light dark; --line: color-mix(in srgb, currentColor 15%, transparent); }
    body { max-width: 60rem; margin: 0 auto; padding: 2rem 1rem 4rem; font: 16px/1.5 system-ui, sans-serif; }
    h1 { margin-bottom: .25rem; }
    .muted { opacity: .65; }
    .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); margin: 2rem 0; }
    .card { border: 1px solid var(--line); border-radius: .75rem; padding: 1.25rem; display: flex; flex-direction: column; gap: .5rem; }
    .price { font-size: 1.75rem; font-weight: 600; }
    button { margin-top: auto; padding: .7rem 1rem; border: 0; border-radius: .5rem; background: #1f6feb; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
    button.ghost { background: transparent; color: inherit; border: 1px solid var(--line); padding: .3rem .6rem; font-weight: 400; font-size: .85rem; }
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    th, td { text-align: left; padding: .5rem .4rem; border-bottom: 1px solid var(--line); vertical-align: top; }
    code, pre { font-family: ui-monospace, monospace; font-size: .82rem; }
    pre { background: color-mix(in srgb, currentColor 7%, transparent); padding: .75rem; border-radius: .5rem; overflow-x: auto; }
    .badge { display: inline-block; padding: .1rem .5rem; border-radius: 1rem; border: 1px solid var(--line); font-size: .8rem; }
    .row-actions { display: flex; gap: .35rem; }
    .err { color: #d1242f; font-size: .8rem; }
    a { color: inherit; }
  </style>
</head>
<body>
{{{body}}}
</body>
</html>
